# Keep line endings identical on every OS (macOS, Linux, Windows).
# Review approvals bind to a scope_hash of the exact staged bytes, so a CRLF
# conversion on any checkout would silently invalidate them.
* text=auto eol=lf

# Binary assets: never convert or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.zip  binary
